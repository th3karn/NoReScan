        "@norescan/dependency-graph": "workspace:*",
        "@norescan/ecosystems": "workspace:*",
        "@norescan/shared": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "typescript": "^5.8.2",
        "vitest": "^3.0.8"
    },
    "publishConfig": {
