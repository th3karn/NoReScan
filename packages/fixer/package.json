{
    "name": "@norescan/fixer",
    "version": "0.1.1",
    "description": "Autonomous test diagnostic, blast-radius error localization, and auto-fix engine for NoReScan",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
