{
    "name":  "bugbrain",
    "version":  "0.1.0",
    "description":  "Universal persistent codebase memory CLI for AI coding agents",
    "license":  "Apache-2.0",
    "author":  "LostGit Solutions",
    "homepage":  "https://github.com/th3karn/BugBrain#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/th3karn/BugBrain.git",
                       "directory":  "packages/cli"
                   },
    "keywords":  [
                     "ai",
                     "memory",
                     "codebase",
                     "mcp",
                     "context",
