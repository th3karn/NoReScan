{
  "name": "repomind",
  "version": "0.1.0",
  "description": "Universal persistent codebase memory CLI for AI coding agents",
  "bin": {
    "repomind": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
